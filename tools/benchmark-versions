#!/bin/sh
# Benchmark the working tree against a release, by default the latest.
# Usage: tools/benchmark-versions [RELEASE] [BENCHMARK ARGUMENTS...]

set -e
cd "$(dirname "$0")/.."
RELEASE=$(git describe --tags --abbrev=0)
if git rev-parse -q --verify "refs/tags/$1" > /dev/null; then
    RELEASE=$1
    shift
fi
CURRENT=$(git describe --tags --dirty)
OUT_FILE=benchmark-versions.csv
WORKTREE=$(mktemp -d)
trap 'git worktree remove --force "$WORKTREE"' EXIT
trap 'exit 1' INT TERM
git worktree add -q --detach "$WORKTREE" "$RELEASE"
printf "\n$RELEASE:\n"
PYTHONPATH="$WORKTREE" uv run python tools/benchmark -o "$OUT_FILE" --version="$RELEASE" "$@"
printf "\n$CURRENT:\n"
uv run python tools/benchmark -o "$WORKTREE/current.csv" --version="$CURRENT" "$@"
tail -n+2 "$WORKTREE/current.csv" >> "$OUT_FILE"
